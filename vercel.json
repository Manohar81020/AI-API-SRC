{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/text=(.*)", "destination": "/api/index.py?text=$1" },
    { "source": "/api/text=(.*)", "destination": "/api/index.py?text=$1" }
  ]
}